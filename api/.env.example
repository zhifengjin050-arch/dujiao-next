# ============================================
# Dujiao-Next API 环境变量配置示例
# 复制此文件为 .env 并修改实际值
# ============================================

# --- 应用配置 ---
APP_SECRET_KEY=your-secret-key-change-in-production
APP_DEBUG=true

# --- 数据库配置 ---
DB_DRIVER=sqlite
DB_DSN=./db/dujiao.db

# --- JWT 配置 ---
JWT_SECRET=your-jwt-secret-change-in-production
USER_JWT_SECRET=user-jwt-secret-change-in-production

# --- 服务器配置 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug

# --- Redis 配置 ---
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- 队列配置 ---
QUEUE_ENABLED=true
QUEUE_HOST=127.0.0.1
QUEUE_PORT=6379
QUEUE_PASSWORD=
QUEUE_DB=0

# --- 邮件配置 ---
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Dujiao-Next

# --- Telegram 配置 ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=

# --- 初始化管理员 ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-in-production